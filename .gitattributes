working/evidence/selector-runtime-20261102/**/*.md   text eol=lf
working/evidence/selector-runtime-20261102/**/*.txt  text eol=lf
release/SELECTOR_INTEGRATION.md text eol=lf
# Preserve exact hashes of native live captures and qualification receipts.
working/evidence/selector-live-20261102/** -text
